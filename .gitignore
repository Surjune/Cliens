# Secrets — never commit. See .env.example for the required keys.
.env
.env.*
!.env.example
*-service-account*.json
credentials/
# Google service-account keys are downloaded under their own project name, e.g.
# `earth-504811-6cc61550fea6.json`, which the pattern above does not match. This
# catches any file whose name is a GCP project id followed by a key fingerprint.
[a-z]*-[0-9]*-[0-9a-f]*.json
gcp-key*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node
node_modules/
dist/
.vite/
coverage/
*.local

# Generated from the backend OpenAPI spec by `npm run generate:types`.
# Deliberately COMMITTED rather than ignored: generating it requires a running
# backend, so ignoring it would leave a fresh clone unable to typecheck or build
# the frontend. Never hand-edit it — regenerate instead.

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

# ---------------------------------------------------------------------------
# Large data artifacts
#
# The GRIB record is 129 MB — past GitHub's 100 MB hard limit — and everything
# below it is derived from it by `ml/grib_to_csv.py`, so a clone regenerates them.
# What the application actually reads at run time is
# `backend/app/repositories/data/district_climate_profiles.json`, which is small
# and IS committed, so a fresh clone can score without the source file present.
# ---------------------------------------------------------------------------
*.grib
*.grib.*.idx
ml/data/*.csv
